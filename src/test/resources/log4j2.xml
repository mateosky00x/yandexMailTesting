<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- File Appender - matches your original path -->
        <File name="File" fileName="target/logs/github-automation.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>

        <!-- Rolling File Appender for better log management -->
        <RollingFile name="RollingFile" fileName="target/logs/automation-rolling.log"
                     filePattern="target/logs/automation-rolling-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>

        <!-- ReportPortal Appender - sends logs to ReportPortal -->
        <ReportPortalLog4j2Appender name="ReportPortalAppender">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"/>
        </ReportPortalLog4j2Appender>
    </Appenders>

    <Loggers>
        <!-- Root Logger - logs to Console, File, and ReportPortal -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="ReportPortalAppender"/>
        </Root>

        <!-- Your Page Object Classes -->
        <Logger name="com.epam.ta.page" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="ReportPortalAppender"/>
        </Logger>

        <!-- Your Test Classes -->
        <Logger name="com.epam.ta.test" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="ReportPortalAppender"/>
        </Logger>

        <!-- Binary data logger for screenshots/attachments in ReportPortal -->
        <Logger name="binary_data_logger" level="TRACE" additivity="false">
            <AppenderRef ref="ReportPortalAppender"/>
        </Logger>

        <!-- Reduce Selenium noise -->
        <Logger name="org.openqa.selenium" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Reduce WebDriverManager noise -->
        <Logger name="io.github.bonigarcia.wdm" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Reduce HTTP client noise -->
        <Logger name="org.apache.http" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Reduce ReportPortal client noise (optional) -->
        <Logger name="com.epam.reportportal" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Reduce ReportPortal HTTP client noise (optional) -->
        <Logger name="com.epam.reportportal.service" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>